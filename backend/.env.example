# Environment Variables Template
# Copy this to .env and fill in your values

# Server
PORT=3000
NODE_ENV=development

# Database - PostgreSQL
# IMPORTANT: Add connection pooling parameters for production
DATABASE_URL="postgresql://user:password@localhost:5432/dbname?connection_limit=20&pool_timeout=10&statement_timeout=30000"

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Judge0 API
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=your-judge0-api-key

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/user/google/callback

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloudinary-name
CLOUDINARY_API_KEY=your-cloudinary-key
CLOUDINARY_API_SECRET=your-cloudinary-secret

# Gemini AI
GEMINI_API_KEY=your-gemini-api-key

# Razorpay
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-secret

# Queue Configuration
QUEUE_JOB_TIMEOUT=60000
WORKER_CONCURRENCY=5

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
FRONTEND_PROD_URL=https://yourdomain.com
