# Environment Variables Template
# Copy this to .env and fill in your values

# Server
PORT=3000
NODE_ENV=development

# Database - PostgreSQL
# IMPORTANT: Add connection pooling parameters for production
DATABASE_URL="postgresql://user:password@localhost:5432/dbname?connection_limit=20&pool_timeout=10&statement_timeout=30000"

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Redis Configuration
# Option 1: Local Redis (self-hosted)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Option 2: Upstash Redis (managed, free tier available)
# If REDIS_URL is set, it will be used instead of REDIS_HOST/PORT
# Get your URL from: https://console.upstash.com/
# REDIS_URL=rediss://default:YOUR_PASSWORD@YOUR_ENDPOINT.upstash.io:6379

# Judge0 Configuration
# Choose ONE of the following options:

# Option 1: RapidAPI / Sulu.sh (Managed, requires API key)
# JUDGE0_BATCH_SUBMISSION_ENDPOINT=https://judge0-ce.p.sulu.sh
# JUDGE0_SULU_API_KEY=your-sulu-api-key-here

# Option 2: Self-hosted Judge0 (No API key needed)
# Example for AWS t2.micro: http://YOUR_AWS_IP:2358
# Example for local: http://localhost:2358
JUDGE0_BATCH_SUBMISSION_ENDPOINT=http://localhost:2358
JUDGE0_SULU_API_KEY=

# Note: If JUDGE0_SULU_API_KEY is empty, the app assumes self-hosted mode

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/user/google/callback

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloudinary-name
CLOUDINARY_API_KEY=your-cloudinary-key
CLOUDINARY_API_SECRET=your-cloudinary-secret

# Gemini AI
GEMINI_API_KEY=your-gemini-api-key

# Razorpay
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-secret

# Queue Configuration
QUEUE_JOB_TIMEOUT=60000
WORKER_CONCURRENCY=5

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
FRONTEND_PROD_URL=https://yourdomain.com


REDIS_URL=rediss://default:AVjNAAI


RESEND_API_KEY=""
EMAIL_FROM=CODELOOM <noreply@codeloom.software>

